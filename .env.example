# Copy to .env.local (git ignores *.local) to sign in with Strava during `npm run dev`.
# The same two variables are set in Vercel: Project → Settings → Environment Variables.
# Never commit the secret.
STRAVA_CLIENT_ID=300555
STRAVA_CLIENT_SECRET=

# Mailing list (optional): from the embed code of a MailerLite form, Forms → your form → Embed.
# In the snippet's URL https://assets.mailerlite.com/jsonp/<ACCOUNT>/forms/<FORM>/subscribe.
# Both are public. Leave them empty and the sign-up form stays hidden.
VITE_MAILERLITE_ACCOUNT=
VITE_MAILERLITE_FORM=
